# development, test or production
NODE_ENV=development

# which part of the server this process runs: api, worker or all
ROLE=all

# port the api listens on
PORT=4000

# origin the browser uses; oauth redirect urls are built from this
APP_URL=http://localhost:5173

# pino level: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# postgres connection string
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler

# redis connection string
REDIS_URL=redis://localhost:6379

# elasticsearch base url
ELASTICSEARCH_URL=http://localhost:9200

# leave empty for a local cluster with security disabled
ELASTICSEARCH_API_KEY=

# signs the session and slack-state jwts; at least 32 characters
SESSION_SECRET=

# base64 of 32 random bytes, used to encrypt sender passwords and slack tokens at rest
ENCRYPTION_KEY=

# google oauth client id, from console.cloud.google.com
GOOGLE_CLIENT_ID=

# google oauth client secret
GOOGLE_CLIENT_SECRET=

# slack app client id; leave empty to turn off slack features
SLACK_CLIENT_ID=

# slack app client secret
SLACK_CLIENT_SECRET=

# https origin for the slack oauth callback, e.g. an ngrok url in local dev
SLACK_REDIRECT_BASE_URL=

# how many jobs the send worker processes at once, per process
WORKER_CONCURRENCY=5

# minimum gap between two sends from the same sender, in milliseconds; 0 disables pacing
MIN_SEND_INTERVAL_MS=2000

# default per-sender hourly cap; a sender's own hourly_limit overrides this
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# hourly cap across every sender combined; 0 turns the global bucket off
MAX_EMAILS_PER_HOUR_GLOBAL=0

# length of an hourly rate-limit window, in milliseconds; only change this for tests or the load test
RATE_WINDOW_MS=3600000

# how many times the send worker retries a temporary failure before giving up
SEND_MAX_ATTEMPTS=5

# how many ethereal test accounts to create on first api boot when the senders table is empty
ETHEREAL_SENDER_COUNT=3

# smtp sends through ethereal; json writes messages to nodemailer's json transport instead, for tests
MAIL_TRANSPORT=smtp

# true makes bull board read-only; set this in production
BULL_BOARD_READ_ONLY=false

# postgres password, read by both the app and the postgres container
POSTGRES_PASSWORD=scheduler

# public hostname for the api, used by caddy in production only
API_DOMAIN=
