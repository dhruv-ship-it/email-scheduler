{
  "name": "@scheduler/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main.ts api",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main.ts worker",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "senders:create": "tsx --env-file-if-exists=../../.env src/scripts/create-senders.ts",
    "load-test": "tsx --env-file-if-exists=../../.env src/scripts/load-test.ts",
    "reconcile": "tsx --env-file-if-exists=../../.env src/scripts/reconcile.ts",
    "sample:schedule": "tsx --env-file-if-exists=../../.env src/scripts/schedule-sample.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@bull-board/api": "^9.11.0",
    "@bull-board/express": "^9.11.0",
    "@elastic/elasticsearch": "^8.19.2",
    "@scheduler/shared": "*",
    "bullmq": "^6.5.4",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  }
}
